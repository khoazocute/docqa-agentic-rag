# ---- Models -------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# Model used by the ADK agent (conversation + tool calling)
ADK_MODEL=gemini-3.5-flash-lite
# LlamaIndex answer generation and embeddings: google | ollama
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.1
EMBED_PROVIDER=google
EMBED_MODEL=gemini-embedding-2
# Only used when a provider is "ollama" (e.g. LLM_MODEL=qwen2.5:7b, EMBED_MODEL=embeddinggemma)
OLLAMA_BASE_URL=http://localhost:11434

# ---- Data & index ---------------------------------------------------------
DATA_DIR=data
STORAGE_DIR=storage
# simple (JSON files) | qdrant (requires: pip install -e ".[qdrant]")
VECTOR_STORE=simple
# Qdrant server, e.g. http://localhost:6333 (docker compose starts one).
# Leave empty for embedded mode in storage/qdrant (only one process can open it at a time).
QDRANT_URL=
QDRANT_API_KEY=
# sentence: fixed-size sentence splitting (default). structure: split by headings and
# tables first (Word styles, Markdown #, numbered headings), keep table rows intact and
# embed the heading path with every chunk; files without structure fall back to sentence.
# semantic: cut where consecutive sentences shift in meaning (one extra embedding per sentence).
CHUNK_STRATEGY=sentence
# With CHUNK_STRATEGY=structure: how files WITHOUT headings/tables are split (semantic|sentence)
STRUCTURE_FALLBACK=semantic
# Cut at distances above this percentile of consecutive-sentence cosine distances
SEMANTIC_BREAKPOINT_PERCENTILE=95
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# Pages shorter than this (slide titles, image-only pages) are merged into the next page
MIN_PART_CHARS=200
# Describe images (PDF pages, Word figures) with the multimodal LLM at ingestion so text
# inside diagrams and image-only slides becomes searchable. One LLM call per new image;
# descriptions are cached in STORAGE_DIR/captions. Word figures need CHUNK_STRATEGY=structure.
IMAGE_CAPTIONS=false
MAX_IMAGES_PER_FILE=40
# Sync new/changed/deleted files automatically when a process loads the index
AUTO_SYNC=true

# ---- Retrieval ------------------------------------------------------------
# vector | bm25 | hybrid
RETRIEVAL_MODE=hybrid
# Candidates fetched from each retriever before fusion, and chunks given to the LLM
CANDIDATE_TOP_K=8
TOP_K=4
RRF_K=60
# Skip the LLM when the best semantic match is below this score.
# 0.55 = calibrated for gemini-embedding-2 on the demo set; re-run `docqa eval` after changing models
MIN_SIMILARITY=0.55

# ---- API --------------------------------------------------------------------
# When set, upload/delete/sync/rebuild endpoints require header X-API-Key
DOCQA_API_KEY=
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO
